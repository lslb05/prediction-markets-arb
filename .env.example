# Copy to .env locally. Never commit real credentials.
PREDICTION_MARKETS_LOG_LEVEL=INFO
PREDICTION_MARKETS_DATA_DIR=data

# Matches this repository's docker-compose.yml; override in production.
PREDICTION_MARKETS_POSTGRES_DSN=postgresql://markets:markets@localhost:5434/prediction_markets

# Kalshi signs every endpoint, including the public market catalogue, so
# ingestion cannot start without a key pair. Create one under Account >
# API Keys, save the PEM it gives you once, and put it in secrets/ -- the
# whole directory is gitignored.
PREDICTION_MARKETS_KALSHI_KEY_ID=
PREDICTION_MARKETS_KALSHI_PRIVATE_KEY_PATH=secrets/kalshi.pem

# Thresholds. Cosine is the cheap recall gate, the cross-encoder the
# expensive precision one; min_edge_bps is what counts as an opportunity
# after Kalshi's fee.
PREDICTION_MARKETS_MIN_SIMILARITY=0.75
PREDICTION_MARKETS_MIN_RERANK=0.0
PREDICTION_MARKETS_MIN_EDGE_BPS=200

# --- trader/ (TypeScript) ---
# The bot refuses to send an order unless this is exactly "true". Anything
# else, including unset, runs it in dry-run: it prices, logs and decides,
# but never routes.
TRADER_LIVE=false
TRADER_KALSHI_KEY_ID=
TRADER_KALSHI_PRIVATE_KEY_PATH=secrets/kalshi.pem
TRADER_POLYMARKET_PRIVATE_KEY=
TRADER_POLYMARKET_API_KEY=
TRADER_POLYMARKET_API_SECRET=
TRADER_POLYMARKET_PASSPHRASE=
TRADER_POLYMARKET_FUNDER=
